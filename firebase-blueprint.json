{
  "entities": {
    "designs": {
      "title": "Flyer Designs",
      "description": "Saved flyer design templates and custom user creations for Dolomiti NordicSki",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Design title or package name"
        },
        "description": {
          "type": "string",
          "description": "Optional brief description of the design"
        },
        "regionId": {
          "type": "string",
          "description": "Selected regional partner ID"
        },
        "graphicStyle": {
          "type": "string",
          "description": "Graphic style variant"
        },
        "themeColor": {
          "type": "string",
          "description": "Color scheme"
        },
        "content": {
          "type": "object",
          "description": "Full FlyerContent state JSON"
        },
        "thumbnail": {
          "type": "string",
          "description": "Base64 or URL thumbnail preview"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["title", "content", "createdAt"]
    },
    "custom_icons": {
      "title": "Custom Sports Icons",
      "description": "User uploaded custom sports icons and brand symbols",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Icon name"
        },
        "category": {
          "type": "string",
          "description": "Category name"
        },
        "customIconUrl": {
          "type": "string",
          "description": "Base64 or image URL uploaded from PC"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["name", "customIconUrl"]
    }
  }
}
