rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /designs/{designId} {
      allow read, write: if true;
    }
    match /flyer_registry/{recordId} {
      allow read, write: if true;
    }
    match /custom_icons/{iconId} {
      allow read, write: if true;
    }
  }
}
